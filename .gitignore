# Obsidian — traces personnelles à ne pas versionner
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/graph.json
.obsidian/bookmarks.json

# Obsidian — trash local
.trash/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Éditeurs
.vscode/
.idea/
*.swp
*.swo
*~

# Python (pour les scripts de skills)
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# Node (si un skill utilise Node)
node_modules/

# Fichiers d'introspection intime — JAMAIS versionnés
# (au cas où un bateleur placerait sa note dans le repo par erreur)
introspection*.md
introspection*.txt
introspection*.pdf
introspection*.docx
*-introspection.*

# TTS Piper — flags de session et modèles téléchargés à la demande
.claude/hooks/tts_enabled
.claude/hooks/tts_piper_voice
.claude/hooks/piper_tts.lock
.claude/hooks/piper/voices/*.onnx
.claude/hooks/piper/voices/*.onnx.json
