.idea/
*.swp
*.swo
*~

# Python (pour les scripts de skills)
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# Node (si un skill utilise Node)
node_modules/

# Fichiers d'introspection intime — JAMAIS versionnés
